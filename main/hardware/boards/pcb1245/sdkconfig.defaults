# ──────────────────────────────────────────────────────────────
# Board overlay: PCB1245 (the KC1245 gateway). Overlays the root
# sdkconfig.defaults and wins on conflicts (composed in the root CMakeLists).
#
# This file is what makes the board a complete platform rather than a pinout:
# the root defaults hold what the APPLICATION needs and assert nothing about
# hardware, so everything below is this board's to state.
#
# The chip itself is NOT set here. IDF resolves IDF_TARGET in an early pass that
# cannot see -DBOARD (the note in main/CMakeLists.txt), so select it the
# ordinary way:
#   idf.py -DBOARD=pcb1245 set-target esp32
# ──────────────────────────────────────────────────────────────

# ── Flash ──────────────────────────────────────────────────────
# 16 MB. Frequency and mode are what the KC1245 firmware runs at (it leaves
# them at ESP-IDF's defaults for the ESP32), written out so the board's file
# states them.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# ── PSRAM ──────────────────────────────────────────────────────
CONFIG_SPIRAM=y

# ── Partition table ────────────────────────────────────────────
# This board's own, sized to the 16 MB above. The path is relative to the
# project root, and the file sits beside this one so a board is one folder.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="main/hardware/boards/pcb1245/partitions.csv"
